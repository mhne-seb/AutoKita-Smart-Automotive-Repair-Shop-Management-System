# Database (Supabase Postgres)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# Email (Gmail SMTP for temp-password + notification emails)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret for Email_parser/gmail_fetcher.py -> /api/diagnostics/store (sent as X-API-Key).
# Any long random string; the SAME value must be set here (and on Vercel) and where the script runs.
DIAGNOSTICS_API_KEY=

# Supabase Storage (inspection photos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App
# Also the base of password-reset links, so it must be the real site address in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Show the "Quick Demo Access" buttons on the live site (they always show in `npm run dev`).
# They contain real account passwords, so keep this off except during a demo. Needs a redeploy to change.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# 2FA one-time codes (quotation approval). Any long random string, e.g. `openssl rand -hex 32`
OTP_SECRET=
# Signs the login cookie so it can't be faked. At least 32 characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Python server (ML predictions + Gmail/PDF parser, models/predict_server.py).
# Leave both empty on your laptop: the site uses http://127.0.0.1:5001 (run_backend.bat).
# Online (Vercel): ML_SERVER_URL is the Render address, and ML_API_KEY must be the
# same value as ML_API_KEY on Render. Generate one with the same command as SESSION_SECRET.
ML_SERVER_URL=
ML_API_KEY=
